    "prestart": "npm run build"
  },
  "dependencies": {
    "@ubeeq/extension-sdk": "file:../../packages/extension-sdk",
    "@ubeeq/ui": "file:../../packages/ui",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "esbuild": "^0.25.12"
  }
}
