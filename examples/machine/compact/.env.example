# Use a DNS name which resolves to this machine before starting the TLS proxy.
UBEEQ_PUBLIC_HOST=workspace.example.org
UBEEQ_INSTANCE_ID=community-instance
UBEEQ_CELL_ID=community-eu-west
UBEEQ_CELL_REGION=eu-west
UBEEQ_CELL_OPERATOR=Example Community
# Keep this secret outside source control. Rotate it deliberately: it protects
# locally stored credential references and invalidates locally issued delivery URLs.
UBEEQ_CREDENTIAL_ENCRYPTION_KEY=replace-with-a-long-random-secret
