{
  "name": "@ubeeq/adapters-local",
  "version": "0.1.0",
  "private": false,
  "publishConfig": { "access": "public" },
  "files": ["dist", "migrations"],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json && rm -rf dist/migrations && cp -R migrations dist/migrations",
    "test:contract": "npm run build && node --test test/contracts.test.mjs",
    "test": "npm run test:contract && node --test test/*.test.mjs"
  },
  "dependencies": {
    "@ubeeq/auth": "^0.1.0",
    "@ubeeq/integrations": "^0.1.0",
    "@ubeeq/jobs": "^0.1.0",
    "@ubeeq/persistence": "^0.1.0",
    "@ubeeq/storage": "^0.1.0"
  }
}
