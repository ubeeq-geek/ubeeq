{
  "name": "@ubeeq/portability",
  "version": "0.1.0",
  "private": false,
  "publishConfig": { "access": "public" },
  "files": ["dist"],
  "main": "dist/index.js",
  "exports": {
    ".": {
      "import": "./dist/esm/index.js",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
