      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "dependencies": {
    "@ubeeq/core": "^0.1.0",
    "@ubeeq/extension-sdk": "^0.1.0",
    "@ubeeq/ui": "^0.1.0"
  },
  "devDependencies": {
    "@types/react": "18.3.31",
    "@types/react-dom": "^18.3.7",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "typescript": "^5.7.3"
  }
}
